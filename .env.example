# Required account and campaign settings. Use your own current activity URL.
TELECOM_PHONE=replace_with_beijing_telecom_number
TELECOM_ENTRY_URL=https://wapbj.189.cn/replace-with-current-entry-path

# Package preset: voice200 or 5g. Custom values require product and plan fields.
TELECOM_TARGET_PACKAGE=voice200
TELECOM_PRODUCT_NAME=
TELECOM_EXPECTED_PLAN_ID=

# Safe local defaults.
TELECOM_ACTION_DELAY_MS=800
TELECOM_POST_SUCCESS_WAIT_MS=8000
TELECOM_CONNECTIVITY_MODE=direct
ALLOW_DIRECT_PROXY_FALLBACK=false
HEADLESS=false
DRY_RUN_BEFORE_FINAL_SUBMIT=true

# SMS provider: pushplus or http.
SMS_INBOX_PROVIDER=pushplus
SMS_SENDER=10001
TELECOM_SUCCESS_SMS_SENDER=10000
SMS_TIMEOUT_MS=90000
SMS_POLL_MS=5000
SEND_CODE_ATTEMPTS=1

# PushPlus Open API. Keep credentials out of tracked files.
PUSHPLUS_TOKEN=
PUSHPLUS_SECRET_KEY=
PUSHPLUS_BASE_URL=https://www.pushplus.plus
PUSHPLUS_KEYWORD=
PUSHPLUS_TITLE_KEYWORD=
PUSHPLUS_PAGE_SIZE=10
PUSHPLUS_DEBUG=false

# Optional protected inbox from PushPlusSmsToTelegram.
PUSHPLUS_RELAY_INBOX_URL=
PUSHPLUS_RELAY_INBOX_TOKEN=

# Optional HTTP SMS inbox.
SMS_INBOX_URL=https://sms-inbox.example.com/messages
SMS_INBOX_HEALTH_URL=https://sms-inbox.example.com/health
SMS_INBOX_TOKEN=
SMS_INBOX_PORT=8787

# Optional proxy reachable directly from this machine.
OPENWRT_HTTP_PROXY=
PROXY_POOL_HTTP_PROXY=

# Optional visual second opinion for the current slider challenge.
GEMINI_API_KEY=
TELECOM_VISION_URL=https://generativelanguage.googleapis.com/v1beta/models/gemini-3.5-flash:generateContent
TELECOM_VISION_MODE=gemini
TELECOM_VISION_MODEL=gemini-3.5-flash
