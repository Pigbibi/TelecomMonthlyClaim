# Required account and campaign settings. Use your own current activity URL.
# Keep the real share link (especially wxopenid) out of git — put it in a secret / local env.
TELECOM_PHONE=replace_with_beijing_telecom_number
TELECOM_ENTRY_URL=https://wapbj.189.cn/wap2017/index/preDepositHighPic_check.html?campaignId=replace_me&version=V1&channelId=replace_me&wxopenid=replace_me

# Open-source-friendly entry shape checks (values are never compared except optional channel pin).
TELECOM_ENTRY_REQUIRED_PARAMS=campaignId,channelId,wxopenid
# TELECOM_EXPECTED_CHANNEL_ID=dx531

# Package preset: voice200 or 5g. Custom values require product and plan fields.
TELECOM_TARGET_PACKAGE=voice200
TELECOM_PRODUCT_NAME=
TELECOM_EXPECTED_PLAN_ID=

# Safe local defaults.
TELECOM_ACTION_DELAY_MS=800
TELECOM_POST_SUCCESS_WAIT_MS=8000
TELECOM_CONNECTIVITY_MODE=direct
ALLOW_DIRECT_PROXY_FALLBACK=false
HEADLESS=false
DRY_RUN_BEFORE_FINAL_SUBMIT=true

# SMS provider: pushplus or http.
SMS_INBOX_PROVIDER=pushplus
SMS_SENDER=10001
TELECOM_SUCCESS_SMS_SENDER=10000
SMS_TIMEOUT_MS=90000
SMS_POLL_MS=5000
SEND_CODE_ATTEMPTS=1

# PushPlus Open API. Keep credentials out of tracked files.
PUSHPLUS_TOKEN=
PUSHPLUS_SECRET_KEY=
PUSHPLUS_BASE_URL=https://www.pushplus.plus
PUSHPLUS_KEYWORD=
PUSHPLUS_TITLE_KEYWORD=
PUSHPLUS_PAGE_SIZE=10
PUSHPLUS_DEBUG=false

# Optional protected inbox from PushPlusSmsToTelegram.
PUSHPLUS_RELAY_INBOX_URL=
PUSHPLUS_RELAY_INBOX_TOKEN=

# Optional HTTP SMS inbox.
SMS_INBOX_URL=https://sms-inbox.example.com/messages
SMS_INBOX_HEALTH_URL=https://sms-inbox.example.com/health
SMS_INBOX_TOKEN=
SMS_INBOX_PORT=8787

# Optional proxy reachable directly from this machine.
OPENWRT_HTTP_PROXY=
PROXY_POOL_HTTP_PROXY=

# Optional visual fallback. Off unless TELECOM_VISION_FALLBACK=true.
# Implicit Gemini image fallback uses CODEX_GATEWAY_COMMAND --providers gemini-free.
# Model override: CODEX_GATEWAY_SLIDER_GEMINI_MODEL (Gateway task variable).
# An explicit TELECOM_VISION_URL keeps custom HTTP, including non-Gemini providers.
TELECOM_VISION_FALLBACK=false
# GEMINI_API_KEY=
# CODEX_GATEWAY_COMMAND=
# CODEX_GATEWAY_SLIDER_GEMINI_MODEL=gemini-flash-lite-latest
# TELECOM_VISION_URL=https://api.openai.com/v1/chat/completions
# TELECOM_VISION_MODE=openai
# TELECOM_VISION_MODEL=
